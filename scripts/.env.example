# Betfair Credentials
BETFAIR_USERNAME=seu_email@email.com
BETFAIR_PASSWORD=sua_senha
BETFAIR_APP_KEY=sua_app_key
BETFAIR_JURISDICTION=bet.br

# Certificates (paths relativos ao diretório scripts/)
BETFAIR_CERT_PATH=../certs/client-2048.crt
BETFAIR_KEY_PATH=../certs/client-2048.key

# Supabase (apenas para registro de dados - opcional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Trading defaults
BETFAIR_TRADING_ENABLED=true
MAX_EXPOSURE_PER_MARKET=10.00
DEFAULT_STAKE=2.00
